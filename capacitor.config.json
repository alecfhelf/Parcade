{
  "appId": "golf.parcade.app",
  "appName": "Parcade",
  "webDir": "public",
  "server": {
    "url": "https://parcade.golf",
    "cleartext": false,
    "errorPath": "offline.html"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#050817"
  },
  "backgroundColor": "#050817",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#050817",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK"
    }
  }
}
